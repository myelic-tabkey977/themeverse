{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": false,
      "segments": [
        {
          "type": "root",
          "style": "diamond",
          "leading_diamond": "",
          "foreground": "#0C0716",
          "background": "#FACC15",
          "template": "  "
        },
        {
          "type": "session",
          "style": "diamond",
          "leading_diamond": "",
          "foreground": "#0C0716",
          "background": "#7C3AED",
          "template": " {{ .UserName }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "foreground": "#F2ECFA",
          "background": "#F8FAFC",
          "template": "  {{ path .Path .Location }} ",
          "properties": {
            "style": "agnoster_short"
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "foreground": "#F2ECFA",
          "background": "#686371",
          "template": " {{ .HEAD }} "
        },
        {
          "type": "executiontime",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "foreground": "#F2ECFA",
          "background": "#FFA726",
          "template": "  {{ .FormattedMs }} ",
          "properties": {
            "threshold": 500
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "node",
          "style": "diamond",
          "leading_diamond": "",
          "foreground": "#0C0716",
          "background": "#4CAF50",
          "template": "  {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} "
        },
        {
          "type": "python",
          "style": "powerline",
          "foreground": "#0C0716",
          "background": "#4DD0E1",
          "template": "  {{ .Full }} "
        },
        {
          "type": "shell",
          "style": "diamond",
          "trailing_diamond": "",
          "foreground": "#F2ECFA",
          "background": "#FACC15",
          "template": " {{ .Name }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#FACC15",
          "background": "transparent",
          "template": "❯ "
        }
      ]
    }
  ]
}
