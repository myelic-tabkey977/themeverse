  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#686060",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#94A3B8"
      }
    },
    {
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.default"
      ],
      "settings": {
        "foreground": "#94A3B8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "entity.name.function.declaration"
      ],
      "settings": {
        "foreground": "#E5E7EB"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class",
        "storage.type.class",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#FFA726"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#F3E9E9"
      }
    },
    {
      "scope": [
        "variable.language",
        "constant.language",
        "support.variable"
      ],
      "settings": {
        "foreground": "#E5E7EB",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "constant",
        "constant.numeric",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#FFA726"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted.single",
        "string.quoted.double",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#4CAF50"
      }
    },
    {
      "scope": [
        "string.escape",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#4DD0E1"
      }
    },
    {
      "scope": [
        "constant.character.entity"
      ],
      "settings": {
        "foreground": "#F48FB1"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#94A3B8"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#F48FB1"
      }
    },
    {
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.definition"
      ],
      "settings": {
        "foreground": "#686060"
      }
    },
    {
      "scope": [
        "operator",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#EAECEF"
      }
    },
    {
      "scope": [
        "meta.embedded",
        "source.embedded"
      ],
      "settings": {
        "foreground": "#F3E9E9"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#E5E7EB",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#686060",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.link"
      ],
      "settings": {
        "foreground": "#E5E7EB",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.raw",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#4CAF50"
      }
    },
    {
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#E5E7EB"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#EF5350",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "deprecated"
      ],
      "settings": {
        "foreground": "#FFA726",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#E5E7EB"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#4CAF50"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#EF5350"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#FFA726"
      }
    },
    {
      "scope": [
        "source.json punctuation.definition.key"
      ],
      "settings": {
        "foreground": "#E5E7EB"
      }
    },
    {
      "scope": [
        "source.css property-name",
        "source.css property-value"
      ],
      "settings": {
        "foreground": "#F3E9E9"
      }
    },
    {
      "scope": [
        "source.css selector"
      ],
      "settings": {
        "foreground": "#94A3B8"
      }
    }
  ]
}
