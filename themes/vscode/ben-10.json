  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#646B65",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#A7F3D0"
      }
    },
    {
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.default"
      ],
      "settings": {
        "foreground": "#A7F3D0",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "entity.name.function.declaration"
      ],
      "settings": {
        "foreground": "#F5F5F5"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class",
        "storage.type.class",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#FFA726"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#EAF7EE"
      }
    },
    {
      "scope": [
        "variable.language",
        "constant.language",
        "support.variable"
      ],
      "settings": {
        "foreground": "#F5F5F5",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "constant",
        "constant.numeric",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#FFA726"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted.single",
        "string.quoted.double",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#4CAF50"
      }
    },
    {
      "scope": [
        "string.escape",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#4DD0E1"
      }
    },
    {
      "scope": [
        "constant.character.entity"
      ],
      "settings": {
        "foreground": "#F48FB1"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#A7F3D0"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#F48FB1"
      }
    },
    {
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.definition"
      ],
      "settings": {
        "foreground": "#646B65"
      }
    },
    {
      "scope": [
        "operator",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#F7F7F7"
      }
    },
    {
      "scope": [
        "meta.embedded",
        "source.embedded"
      ],
      "settings": {
        "foreground": "#EAF7EE"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#F5F5F5",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#646B65",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.link"
      ],
      "settings": {
        "foreground": "#F5F5F5",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.raw",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#4CAF50"
      }
    },
    {
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#F5F5F5"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#EF5350",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "deprecated"
      ],
      "settings": {
        "foreground": "#FFA726",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#F5F5F5"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#4CAF50"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#EF5350"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#FFA726"
      }
    },
    {
      "scope": [
        "source.json punctuation.definition.key"
      ],
      "settings": {
        "foreground": "#F5F5F5"
      }
    },
    {
      "scope": [
        "source.css property-name",
        "source.css property-value"
      ],
      "settings": {
        "foreground": "#EAF7EE"
      }
    },
    {
      "scope": [
        "source.css selector"
      ],
      "settings": {
        "foreground": "#A7F3D0"
      }
    }
  ]
}
